# M03 requires the Supabase public URL/key and canonical application URL.
# Copy this file to .env.local; never commit real credentials.

# Public: Supabase connection (M02/M03). Safe use requires RLS.
NEXT_PUBLIC_SUPABASE_URL=
# Legacy variable name: use a current sb_publishable_... key (or legacy anon key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only, optional: privileged service operations when required.
SUPABASE_SERVICE_ROLE_KEY=

# Public: Stripe initialization (M08).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server only: Stripe payments (M08) and webhook verification (M09).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Server only: order confirmation email (M13).
RESEND_API_KEY=

# Public: canonical origin and redirects; change per environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Recommended: monitoring (M14). Configure exposure and scrub PII/secrets then.
SENTRY_DSN=
