# M03 requires the Supabase public URL/key and canonical application URL.
# Copy this file to .env.local; never commit real credentials.

# Public: Supabase connection (M02/M03). Safe use requires RLS.
NEXT_PUBLIC_SUPABASE_URL=
# Legacy variable name: use a current sb_publishable_... key (or legacy anon key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: privileged writes from the PayMongo webhook (M09). Never expose or log.
SUPABASE_SERVICE_ROLE_KEY=

# Server only: PayMongo hosted checkout (M08). Test key sk_test_...; live keys require an https NEXT_PUBLIC_APP_URL.
PAYMONGO_SECRET_KEY=
# Server only: PayMongo webhook signature verification (M09).
PAYMONGO_WEBHOOK_SECRET=

# Server only: order confirmation email (M13).
RESEND_API_KEY=
# Server only: sender, e.g. "Atleteka <orders@your-domain.ph>". Testing: "Atleteka <onboarding@resend.dev>" (delivers only to the Resend account owner).
EMAIL_FROM=

# Public: canonical origin and redirects; change per environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public: Sentry error monitoring (M14-P01). A DSN is safe in the browser; events are scrubbed of PII/secrets.
NEXT_PUBLIC_SENTRY_DSN=
